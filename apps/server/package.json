{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "bench:analyze": "tsx scripts/bench-analyze.ts",
    "bench:explore": "tsx scripts/bench-explore.ts",
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@trek-together/api": "workspace:*",
    "@trek-together/auth": "workspace:*",
    "@trek-together/db": "workspace:*",
    "@trek-together/env": "workspace:*",
    "better-auth": "catalog:",
    "cors": "^2.8.5",
    "dotenv": "catalog:",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@trek-together/config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "^0.21.9",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
