{
  "name": "trek-together",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @trek-together/db db:push",
    "db:ping": "turbo -F @trek-together/db db:ping",
    "db:studio": "turbo -F @trek-together/db db:studio",
    "db:generate": "turbo -F @trek-together/db db:generate",
    "db:migrate": "turbo -F @trek-together/db db:migrate",
    "db:start": "turbo -F @trek-together/db db:start",
    "db:watch": "turbo -F @trek-together/db db:watch",
    "db:stop": "turbo -F @trek-together/db db:stop",
    "db:down": "turbo -F @trek-together/db db:down",
    "prepare": "husky"
  },
  "dependencies": {
    "@trek-together/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@trek-together/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "turbo": "^2.9.16",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.17.0",
    "pnpm": ">=11.9.0"
  }
}
