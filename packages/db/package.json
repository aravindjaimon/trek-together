{
  "name": "@trek-together/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "prisma generate",
    "db:push": "prisma db push && tsx src/setup-indexes.ts",
    "db:setup-indexes": "tsx src/setup-indexes.ts",
    "db:ping": "tsx src/ping.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "db:studio": "prisma studio",
    "db:start": "docker compose up -d",
    "db:watch": "docker compose up",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@trek-together/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@trek-together/config": "workspace:*",
    "prisma": "6.19.3",
    "tsx": "^4.22.4",
    "typescript": "catalog:"
  }
}
