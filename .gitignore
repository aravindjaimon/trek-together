# Dependencies
node_modules
.pnp
.pnp.js

# Build outputs
dist
dist-types
build
*.tsbuildinfo

# Generated files
# routeTree.gen.ts is deliberately NOT ignored. It is generated by the TanStack
# Router vite plugin at dev/build time, but `check-types` needs it to exist —
# so ignoring it made a fresh clone fail `pnpm check-types` before anything had
# built. Committed instead: it's deterministic, 182 lines, and biome already
# skips **/*.gen.ts. Regenerate with `pnpm build -F web` after changing routes.

# Environment variables
.env
.env*.local
.env.prod
.envrc
# envx ciphertext. The passphrases live in the gitignored .envrc, so these are
# not readable — but the repo is public and production secrets live in the
# Render/Vercel dashboards, so publishing them buys nothing.
*.gpg

# IDEs and editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea
*.swp
*.swo
*~
.DS_Store

# Logs — anchored to repo root so it never matches source
# (e.g. packages/api/src/routers/logs/). A bare `logs` swallowed the logs router.
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Turbo
.turbo
.nx

# Better-T-Stack
.alchemy

# Testing
coverage
.nyc_output

# Claude Code (machine-local settings — never commit/lint)
.claude/settings.local.json

# Misc
*.tgz
.cache
tmp
temp

# Playwright MCP browser-automation output
.playwright-mcp/
